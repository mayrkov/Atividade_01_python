<mxfile host="app.diagrams.net">
  <diagram id="uml" name="Diagrama de Classes">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="professor" value="&lt;div style='text-align:center;padding:4px'&gt;&lt;b&gt;Professor&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style='padding:0 6px'&gt;- nome: str&lt;br&gt;- cpf: str&lt;br&gt;- disciplina: str&lt;br&gt;- _escolas: list&lt;/div&gt;&lt;hr&gt;&lt;div style='padding:0 6px'&gt;+ adicionar_escola(escola)&lt;br&gt;+ remover_escola(escola)&lt;br&gt;+ listar_escolas(): list&lt;br&gt;+ lecionar(turma): str&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="230" height="186" as="geometry"/></mxCell>
        <mxCell id="escola" value="&lt;div style='text-align:center;padding:4px'&gt;&lt;b&gt;Escola&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style='padding:0 6px'&gt;- nome: str&lt;br&gt;- cnpj: str&lt;br&gt;- telefone: str&lt;br&gt;- ativa: bool&lt;br&gt;- _salas: list&lt;br&gt;- _professores: list&lt;/div&gt;&lt;hr&gt;&lt;div style='padding:0 6px'&gt;+ criar_sala(numero, capacidade, bloco): Sala&lt;br&gt;+ listar_salas(): list&lt;br&gt;+ vincular_professor(p)&lt;br&gt;+ desvincular_professor(p)&lt;br&gt;+ listar_professores(): list&lt;br&gt;+ fechar()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="290" height="254" as="geometry"/></mxCell>
        <mxCell id="sala" value="&lt;div style='text-align:center;padding:4px'&gt;&lt;b&gt;Sala&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style='padding:0 6px'&gt;- numero: str&lt;br&gt;- capacidade: int&lt;br&gt;- bloco: str&lt;br&gt;- ocupacao: int&lt;/div&gt;&lt;hr&gt;&lt;div style='padding:0 6px'&gt;+ tem_vaga(): bool&lt;br&gt;+ ocupar(quantidade)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="210" height="152" as="geometry"/></mxCell>
        <mxCell id="aluno" value="&lt;div style='text-align:center;padding:4px'&gt;&lt;b&gt;Aluno&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style='padding:0 6px'&gt;- nome: str&lt;br&gt;- matricula: str&lt;br&gt;- data_nascimento: str&lt;br&gt;- notas: list&lt;br&gt;- endereco: Endereco&lt;/div&gt;&lt;hr&gt;&lt;div style='padding:0 6px'&gt;+ adicionar_nota(nota)&lt;br&gt;+ calcular_media(): float&lt;br&gt;+ atualizar_endereco(e)&lt;br&gt;+ remover(): Endereco&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="230" height="203" as="geometry"/></mxCell>
        <mxCell id="endereco" value="&lt;div style='text-align:center;padding:4px'&gt;&lt;b&gt;Endereco&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style='padding:0 6px'&gt;- rua: str&lt;br&gt;- numero: str&lt;br&gt;- bairro: str&lt;br&gt;- cidade: str&lt;br&gt;- cep: str&lt;/div&gt;&lt;hr&gt;&lt;div style='padding:0 6px'&gt;+ validar_cep(): bool&lt;br&gt;+ formatar(): str&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="430" width="230" height="169" as="geometry"/></mxCell>
        <mxCell id="e0" value="composição" style="startArrow=diamondThin;startFill=1;startSize=18;endArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="escola" target="sala"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e0s" value="1" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e0"><mxGeometry x="-0.75" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e0t" value="1..*" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e0"><mxGeometry x="0.75" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e1" value="associação" style="endArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="professor" target="escola"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1s" value="0..*" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e1"><mxGeometry x="-0.75" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e1t" value="0..*" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e1"><mxGeometry x="0.75" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e2" value="agregação" style="startArrow=diamondThin;startFill=0;startSize=18;endArrow=none;html=1;fontSize=11;" edge="1" parent="1" source="aluno" target="endereco"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2s" value="1" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e2"><mxGeometry x="-0.75" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="e2t" value="1" style="edgeLabel;html=1;fontSize=11;" vertex="1" connectable="0" parent="e2"><mxGeometry x="0.75" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell>
        <mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;——— associação&lt;br&gt;◇—— agregação (losango vazado)&lt;br&gt;◆—— composição (losango preenchido)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="430" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="titulo" value="Diagrama de Classes - Sistema Escolar" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="500" height="30" as="geometry"/></mxCell>
